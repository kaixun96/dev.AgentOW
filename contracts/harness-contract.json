    ["skills/ow-review/references/sharepoint-theme-and-detheme.md", "copilot/skills/ow-review/references/sharepoint-theme-and-detheme.md"],
    ["skills/ow-review/references/ux-architecture-and-bundle-boundaries.md", "copilot/skills/ow-review/references/ux-architecture-and-bundle-boundaries.md"],
    ["skills/ow-review/references/size-regression.md", "copilot/skills/ow-review/references/size-regression.md"]
  ],
  "typescriptPolicies": [
    {
      "id": "PR_DRAFT_ONLY",
      "file": "ts/src/ow/tools/prClient.ts",
      "kind": "draft-only-pr-client",
      "methods": ["createPr", "updatePr"],
      "inputInterfaces": ["PrCreateInput", "PrUpdateInput"]
    },
    {
      "id": "PR_DRAFT_NOT_CALLER_CONTROLLED",
      "file": "ts/src/ow/mcp/owTools.ts",
      "kind": "forbid-property",
      "properties": ["draft"]
    },
    {
      "id": "PR_ATTACH_NEVER_COMMENTS",
      "file": "ts/src/ow/tools/prAttach.ts",
      "kind": "no-pr-comment-write"
    }
  ],
  "commandPolicies": [
    {
      "id": "REVIEW_VALIDATES_HEAD",
      "file": "copilot/skills/agentow/SKILL.md",
      "startMarker": "agentow-contract:evidence:review-bound-to-head",
      "endMarker": "agentow-contract:delivery:draft-pr",
      "commands": [
        {
          "contains": "validate-graduation-review-report.mjs",
          "requiredArgs": ["--expected-head", "--expected-diff-digest"]
        },
        {
          "contains": "validate-review-report.mjs",
          "requiredArgs": ["--expected-head", "--expected-diff-digest"]
        }
      ]
    }
  ]
