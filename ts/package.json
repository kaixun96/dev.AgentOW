{
  "name": "agentow",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "agentow": "./dist/ow/index.js"
  },
  "scripts": {
    "build": "npm run validate-prompts && npm run validate-review-contract && npm run validate-review-ledger && npm run validate-class-sweep && npm run validate-prior-art && npm run validate-pr-description && tsup && npm run sync-artifacts",
    "sync-artifacts": "node scripts/sync-build-artifacts.mjs",
    "validate-prompts": "node scripts/validate-agentow-prompts.mjs",
    "validate-review-contract": "node scripts/validate-review-report.test.mjs",
    "validate-review-ledger": "node scripts/review-ledger.test.mjs",
    "validate-class-sweep": "node scripts/class-sweep.test.mjs",
    "validate-prior-art": "node scripts/prior-art.test.mjs",
    "validate-pr-description": "node scripts/pr-description-budget.test.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/ow/index.ts mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
